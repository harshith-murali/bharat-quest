# Copy to .env before `docker compose up`.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bharat_quest

# REQUIRED — generate with: openssl rand -base64 48
JWT_SECRET=

# Where the browser reaches the app (must match for cookies to be accepted)
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Optional: Talk uses seeded facts when unset
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

LOG_LEVEL=info
