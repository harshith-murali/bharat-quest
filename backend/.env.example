# Database connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/bharat_quest

# Server port
PORT=3001

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# ─── Talk / chat model (optional) ────────────────────────────────────────────
# Leave HF_API_KEY unset to run without a model: the Talk tab still works and
# answers from the seeded state facts instead.
#
# Any OpenAI-compatible Hugging Face inference endpoint works.
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_ENDPOINT=https://router.huggingface.co/v1/chat/completions

# Max chat messages per section per minute
CHAT_RATE_LIMIT=20

# ─── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without it.
# Anyone who knows this value can forge a staff session, so generate a long
# random string, e.g.  openssl rand -base64 48
JWT_SECRET=

# Used once by `npm run seed:admin` to create the first admin account.
# Not read at runtime; safe to remove after the account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Head Teacher

# Set to "false" ONLY when serving over plain HTTP with no TLS certificate
# (e.g. a bare IP with no domain). Browsers discard Secure cookies over HTTP,
# so staff sign-in fails without this. Remove once HTTPS is in place.
#   auto (default) = secure in production, insecure in development
COOKIE_SECURE=auto
