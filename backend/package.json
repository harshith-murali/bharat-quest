{
  "name": "bharat-quest-backend",
  "version": "1.0.0",
  "description": "Bharat Quest AI \u2014 Backend API (Fastify + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "migrate": "tsx src/migrate.ts",
    "seed:facts": "tsx src/seedFacts.ts",
    "seed:classrooms": "tsx src/seedClassrooms.ts",
    "seed:admin": "tsx src/seedAdmin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.3",
    "pg": "^8.12.0",
    "pino-pretty": "^11.2.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.10"
  }
}